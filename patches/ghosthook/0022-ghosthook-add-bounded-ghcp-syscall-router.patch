diff --git a/kernel/gh_control.c b/kernel/gh_control.c
new file mode 100644
index 000000000000..0ae021a68ae6
--- /dev/null
+++ b/kernel/gh_control.c
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bounded, arm64-private GHCP control bridge.
+ *
+ * The syscall is only a transport gate: it copies one small frame before
+ * dispatch and holds the registration mutex while a registered KPM handler
+ * runs.  Handlers therefore execute in normal syscall process context and
+ * must not unregister themselves from inside the callback.
+ */
+#include <linux/build_bug.h>
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/ghosthook.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+
+struct gh_control_binding {
+	gh_control_handler_t handler;
+	void *context;
+};
+
+static_assert(sizeof(struct gh_control_header_v1) == 64U);
+
+static DEFINE_MUTEX(gh_control_lock);
+static struct gh_control_binding gh_control_binding;
+
+static bool gh_control_command_known(u16 command)
+{
+	return command >= GH_CONTROL_HELLO && command <= GH_CONTROL_TRACE_STOP;
+}
+
+static bool gh_control_session_key_present(const u8 *key)
+{
+	unsigned int i;
+
+	for (i = 0; i < GH_CONTROL_SESSION_KEY_LEN; ++i) {
+		if (key[i])
+			return true;
+	}
+	return false;
+}
+
+static int gh_control_validate(const void *frame, size_t frame_len,
+			       struct gh_control_header_v1 *out)
+{
+	struct gh_control_header_v1 header;
+	size_t expected;
+
+	if (frame_len < sizeof(header))
+		return -EMSGSIZE;
+	memcpy(&header, frame, sizeof(header));
+	if (header.magic != GH_CONTROL_MAGIC || header.abi != GH_CONTROL_ABI_V1)
+		return -EPROTO;
+	if (!gh_control_command_known(header.command))
+		return -EOPNOTSUPP;
+	if (header.flags)
+		return -EINVAL;
+	if (header.payload_len > GH_CONTROL_MAX_PAYLOAD)
+		return -EMSGSIZE;
+	expected = sizeof(header) + (size_t)header.payload_len;
+	if (expected != frame_len)
+		return -EMSGSIZE;
+	if (header.command != GH_CONTROL_HELLO && header.command != GH_CONTROL_CAPS &&
+	    (!header.session_id || !gh_control_session_key_present(header.session_key)))
+		return -EACCES;
+	if (out)
+		*out = header;
+	return 0;
+}
+
+int gh_control_register(gh_control_handler_t handler, void *context)
+{
+	int ret = 0;
+
+	if (!handler)
+		return -EINVAL;
+	mutex_lock(&gh_control_lock);
+	if (gh_control_binding.handler)
+		ret = -EBUSY;
+	else {
+		gh_control_binding.context = context;
+		gh_control_binding.handler = handler;
+	}
+	mutex_unlock(&gh_control_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gh_control_register);
+
+int gh_control_unregister(gh_control_handler_t handler, void *context)
+{
+	int ret = 0;
+
+	if (!handler)
+		return -EINVAL;
+	mutex_lock(&gh_control_lock);
+	if (gh_control_binding.handler != handler ||
+	    gh_control_binding.context != context)
+		ret = -ENOENT;
+	else {
+		gh_control_binding.handler = NULL;
+		gh_control_binding.context = NULL;
+	}
+	mutex_unlock(&gh_control_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gh_control_unregister);
+
+SYSCALL_DEFINE2(ghosthook_control, const void __user *, frame, size_t, frame_len)
+{
+	u8 local[GH_CONTROL_FRAME_MAX];
+	gh_control_handler_t handler;
+	void *context;
+	int ret;
+
+	if (!frame || frame_len < sizeof(struct gh_control_header_v1) ||
+	    frame_len > sizeof(local))
+		return -EMSGSIZE;
+	if (copy_from_user(local, frame, frame_len))
+		return -EFAULT;
+	ret = gh_control_validate(local, frame_len, NULL);
+	if (ret)
+		return ret;
+	/* Serializing dispatch with unregister pins KPM text for this invocation. */
+	mutex_lock(&gh_control_lock);
+	handler = gh_control_binding.handler;
+	context = gh_control_binding.context;
+	if (!handler)
+		ret = -ENODEV;
+	else
+		ret = handler(local, frame_len, context);
+	mutex_unlock(&gh_control_lock);
+	return ret;
+}
