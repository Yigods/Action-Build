--- a/arch/arm64/kernel/gh_ss_trace.c
+++ b/arch/arm64/kernel/gh_ss_trace.c
@@ -40,6 +40,8 @@
 	struct callback_head disarm_work;
 	bool active;
 	bool ss_owned;
+	/* One owned HWSS drains the architecture pending state after the final visible record. */
+	bool final_drain;
 	bool affinity_saved;
 	bool arm_work_pending;
 	bool disarm_work_pending;
@@ -138,20 +140,29 @@
 	if (!gh_ss_trace.active || !gh_ss_trace.ss_owned ||
 	    !gh_ss_trace_task_matches(current))
 		goto out;
-	gh_ss_trace_record_locked(regs);
-	gh_ss_trace.hits++;
-	if (gh_ss_trace.hits >= gh_ss_trace.limit) {
-		/* This exception is already executing in the owned target task.
-		 * Clear both the pending SPSR.SS bit and TIF_SINGLESTEP before
-		 * returning, rather than leaving one unowned step for task_work. */
+	/*
+	 * arm64 advances the HWSS state before delivery.  On this platform the
+	 * final visible event can still have one active-pending transition behind
+	 * it.  Keep ownership for exactly that one extra exception, but never add
+	 * it to the public ring or hit budget; consuming it avoids exposing an
+	 * unowned SIGTRAP to the target on the return path.
+	 */
+	if (gh_ss_trace.final_drain) {
 		user_fastforward_single_step(current);
 		user_disable_single_step(current);
+		gh_ss_trace.final_drain = false;
 		gh_ss_trace.ss_owned = false;
 		gh_ss_trace.active = false;
-	} else {
-		/* We consumed HWSS before stock single_step_handler's rewind. */
-		user_rewind_single_step(current);
+		consumed = true;
+		goto out;
 	}
+
+	gh_ss_trace_record_locked(regs);
+	gh_ss_trace.hits++;
+	if (gh_ss_trace.hits >= gh_ss_trace.limit)
+		gh_ss_trace.final_drain = true;
+	/* We consumed HWSS before stock single_step_handler's rewind. */
+	user_rewind_single_step(current);
 	consumed = true;
 out:
 	raw_spin_unlock_irqrestore(&gh_ss_trace_lock, flags);
@@ -220,6 +231,7 @@
 	gh_ss_trace.cpu = cpu;
 	gh_ss_trace.active = true;
 	gh_ss_trace.ss_owned = false;
+	gh_ss_trace.final_drain = false;
 	gh_ss_trace.affinity_saved = true;
 	init_task_work(&gh_ss_trace.arm_work, gh_ss_trace_arm_work);
 	gh_ss_trace.arm_work_pending = true;
@@ -233,6 +245,7 @@
 			gh_ss_trace.pid = NULL;
 			gh_ss_trace.active = false;
 			gh_ss_trace.ss_owned = false;
+			gh_ss_trace.final_drain = false;
 			gh_ss_trace.affinity_saved = false;
 			gh_ss_trace.arm_work_pending = false;
 		}
@@ -269,6 +282,7 @@
 	cpumask_copy(&saved_mask, &gh_ss_trace.saved_mask);
 	gh_ss_trace.active = false;
 	gh_ss_trace.ss_owned = false;
+	gh_ss_trace.final_drain = false;
 	gh_ss_trace.pid = NULL;
 	gh_ss_trace.affinity_saved = false;
 	if (queue_disarm) {
@@ -366,6 +380,7 @@
 		gh_ss_trace.pid = NULL;
 		gh_ss_trace.active = false;
 		gh_ss_trace.ss_owned = false;
+		gh_ss_trace.final_drain = false;
 		gh_ss_trace.affinity_saved = false;
 	}
 	raw_spin_unlock_irqrestore(&gh_ss_trace_lock, flags);
