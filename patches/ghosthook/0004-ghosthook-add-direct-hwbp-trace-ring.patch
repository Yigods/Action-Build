 	raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
 
 	/* Install immediately if the TID is currently running, else at switch-in. */
+	on_each_cpu(gh_hwbp_direct_reset_trace_current, NULL, 1);
