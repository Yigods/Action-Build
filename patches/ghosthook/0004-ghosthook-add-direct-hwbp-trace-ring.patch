 	bool stepping;
 };
 
+#define GH_HWBP_DIRECT_TRACE_CAP 64
+
+struct gh_hwbp_direct_trace_ring {
+	unsigned long head;
+	unsigned long tail;
+	unsigned long dropped;
+	struct gh_hwbp_direct_trace records[GH_HWBP_DIRECT_TRACE_CAP];
+};
+
 static DEFINE_RAW_SPINLOCK(gh_hwbp_direct_lock);
 static struct gh_hwbp_direct_state gh_hwbp_direct;
 static DEFINE_PER_CPU(bool, gh_hwbp_direct_cpu_enabled);
+static DEFINE_PER_CPU(struct gh_hwbp_direct_trace_ring, gh_hwbp_direct_trace);
 static bool gh_hwbp_direct_router_ready;
 
 static bool gh_hwbp_direct_task_matches(struct task_struct *task)
@@ -123,6 +134,47 @@ static void gh_hwbp_direct_sync_current(void *unused)
 	gh_hwbp_direct_sync_task(current);
 }
 
+static void gh_hwbp_direct_reset_trace_current(void *unused)
+{
+	struct gh_hwbp_direct_trace_ring *ring;
+
+	(void)unused;
+	ring = this_cpu_ptr(&gh_hwbp_direct_trace);
+	ring->head = 0;
+	ring->tail = 0;
+	ring->dropped = 0;
+}
+
+/* Called under gh_hwbp_direct_lock in IRQ-disabled exception context. */
+static void gh_hwbp_direct_record_trace(struct pt_regs *regs)
+{
+	struct gh_hwbp_direct_trace_ring *ring;
+	struct gh_hwbp_direct_trace *record;
+	unsigned long sequence;
+	int i;
+	int cpu = raw_smp_processor_id();
+
+	ring = this_cpu_ptr(&gh_hwbp_direct_trace);
+	sequence = ++ring->head;
+	if (!ring->tail)
+		ring->tail = sequence;
+	else if (sequence - ring->tail >= GH_HWBP_DIRECT_TRACE_CAP) {
+		ring->tail++;
+		ring->dropped++;
+	}
+
+	record = &ring->records[(sequence - 1) % GH_HWBP_DIRECT_TRACE_CAP];
+	record->sequence = sequence;
+	record->tid = pid_nr(gh_hwbp_direct.pid);
+	record->cpu = cpu;
+	record->pc = instruction_pointer(regs);
+	record->sp = regs->sp;
+	record->pstate = regs->pstate;
+	for (i = 0; i < GH_HWBP_DIRECT_TRACE_GPRS; i++)
+		record->regs[i] = regs->regs[i];
+	gh_hwbp_direct.last_cpu = cpu;
+}
