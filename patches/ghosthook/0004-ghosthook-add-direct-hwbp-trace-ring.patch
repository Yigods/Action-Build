 }
 EXPORT_SYMBOL_GPL(gh_hwbp_direct_get_stats);
 
+int gh_hwbp_direct_read_trace(int cpu, unsigned long *cursor,
+			      struct gh_hwbp_direct_trace *records,
+			      unsigned int max_records, unsigned int *copied,
+			      unsigned long *dropped)
+{
+	struct gh_hwbp_direct_trace_ring *ring;
+	unsigned long flags;
+	unsigned long next;
+	unsigned int count = 0;
+
+	if (cpu < 0 || cpu >= nr_cpu_ids || !cursor || !records ||
+	    !max_records || !copied || !dropped)
+		return -EINVAL;
+
+	raw_spin_lock_irqsave(&gh_hwbp_direct_lock, flags);
+	ring = per_cpu_ptr(&gh_hwbp_direct_trace, cpu);
+	next = *cursor;
+	if (!next || (ring->tail && next < ring->tail))
+		next = ring->tail;
+	while (next && next <= ring->head && count < max_records) {
+		records[count++] = ring->records[(next - 1) % GH_HWBP_DIRECT_TRACE_CAP];
+		next++;
+	}
+	*cursor = next;
+	*copied = count;
+	*dropped = ring->dropped;
+	raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gh_hwbp_direct_read_trace);
