diff --git a/arch/arm64/kernel/hw_breakpoint.c b/arch/arm64/kernel/hw_breakpoint.c
index 9659a95..89042d7 100644
--- a/arch/arm64/kernel/hw_breakpoint.c
+++ b/arch/arm64/kernel/hw_breakpoint.c
@@ -10,10 +10,13 @@
 #define pr_fmt(fmt) "hw-breakpoint: " fmt
 
 #include <linux/compat.h>
+#include <linux/cpu.h>
 #include <linux/cpu_pm.h>
 #include <linux/errno.h>
 #include <linux/hw_breakpoint.h>
 #include <linux/kprobes.h>
+#include <linux/ghosthook.h>
+#include <linux/pid.h>
 #include <linux/perf_event.h>
 #include <linux/ptrace.h>
 #include <linux/smp.h>
@@ -39,6 +42,252 @@ static DEFINE_PER_CPU(int, stepping_kernel_bp);
 static int core_num_brps;
 static int core_num_wrps;
 
+/* Used by the direct owner below; the implementation is further down. */
+static void write_wb_reg(int reg, int n, u64 val);
+
+/*
+ * S4-D1 direct EL0 HWBP owner. This is deliberately separate from perf: one
+ * exact TID/PC session owns the final BRP slot while active. Normal perf is
+ * restricted to the remaining slots, and arm refuses an already occupied
+ * reserved slot. The permanent handler is installed through the explicit
+ * debug-router core slot, so it never points into KPM text.
+ */
+struct gh_hwbp_direct_state {
+	struct pid *pid;
+	unsigned long pc;
+	unsigned long hits;
+	int slot;
+	bool active;
+	bool disarming;
+	bool stepping;
+};
+
+static DEFINE_RAW_SPINLOCK(gh_hwbp_direct_lock);
+static struct gh_hwbp_direct_state gh_hwbp_direct;
+static DEFINE_PER_CPU(bool, gh_hwbp_direct_cpu_enabled);
+static bool gh_hwbp_direct_router_ready;
+
+static bool gh_hwbp_direct_task_matches(struct task_struct *task)
+{
+	return gh_hwbp_direct.pid && task_pid(task) == gh_hwbp_direct.pid;
+}
+
+static u32 gh_hwbp_direct_ctrl(void)
+{
+	struct arch_hw_breakpoint_ctrl ctrl = {
+		.len = ARM_BREAKPOINT_LEN_4,
+		.type = ARM_BREAKPOINT_EXECUTE,
+		.privilege = AARCH64_BREAKPOINT_EL0,
+		.enabled = 1,
+	};
+
+	return encode_ctrl_reg(ctrl);
+}
+
+static void gh_hwbp_direct_sync_task(struct task_struct *task)
+{
+	unsigned long flags;
+	unsigned long pc = 0;
+	int slot = -1;
+	bool enable = false;
+
+	raw_spin_lock_irqsave(&gh_hwbp_direct_lock, flags);
+	if (gh_hwbp_direct.active && gh_hwbp_direct_task_matches(task)) {
+		slot = gh_hwbp_direct.slot;
+		pc = gh_hwbp_direct.pc;
+		enable = !gh_hwbp_direct.stepping && !gh_hwbp_direct.disarming;
+	}
+	raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+
+	if (slot < 0) {
+		if (this_cpu_read(gh_hwbp_direct_cpu_enabled)) {
+			/* This CPU has just switched away from the owned TID. */
+			write_wb_reg(AARCH64_DBG_REG_BCR, core_num_brps - 1, 0);
+			disable_debug_monitors(DBG_ACTIVE_EL0);
+			this_cpu_write(gh_hwbp_direct_cpu_enabled, false);
+		}
+		return;
+	}
+
+	if (!this_cpu_read(gh_hwbp_direct_cpu_enabled)) {
+		enable_debug_monitors(DBG_ACTIVE_EL0);
+		this_cpu_write(gh_hwbp_direct_cpu_enabled, true);
+	}
+	write_wb_reg(AARCH64_DBG_REG_BVR, slot, pc);
+	write_wb_reg(AARCH64_DBG_REG_BCR, slot, enable ? gh_hwbp_direct_ctrl() : 0);
+}
+
+static void gh_hwbp_direct_sync_current(void *unused)
+{
+	(void)unused;
+	gh_hwbp_direct_sync_task(current);
+}
+
+static bool gh_hwbp_direct_debug_event(unsigned long addr_if_watchpoint,
+		unsigned long esr, struct pt_regs *regs, void *context)
+{
+	unsigned long flags;
+	unsigned long pc;
+	unsigned int event = DBG_ESR_EVT(esr);
+	bool consumed = false;
+
+	(void)addr_if_watchpoint;
+	(void)context;
+	if (!user_mode(regs))
+		return false;
+
+	pc = instruction_pointer(regs);
+	raw_spin_lock_irqsave(&gh_hwbp_direct_lock, flags);
+	if (!gh_hwbp_direct.active || !gh_hwbp_direct_task_matches(current))
+		goto out;
+
+	if (event == DBG_ESR_EVT_HWBP && !gh_hwbp_direct.disarming &&
+	    !gh_hwbp_direct.stepping &&
+	    pc == gh_hwbp_direct.pc) {
+		/* Disable this exact BRP, execute one original instruction, rearm. */
+		write_wb_reg(AARCH64_DBG_REG_BCR, gh_hwbp_direct.slot, 0);
+		gh_hwbp_direct.hits++;
+		gh_hwbp_direct.stepping = true;
+		user_enable_single_step(current);
+		consumed = true;
+	} else if (event == DBG_ESR_EVT_HWSS && gh_hwbp_direct.stepping) {
+		gh_hwbp_direct.stepping = false;
+		user_disable_single_step(current);
+		if (!gh_hwbp_direct.disarming) {
+			write_wb_reg(AARCH64_DBG_REG_BVR, gh_hwbp_direct.slot,
+				     gh_hwbp_direct.pc);
+			write_wb_reg(AARCH64_DBG_REG_BCR, gh_hwbp_direct.slot,
+				     gh_hwbp_direct_ctrl());
+		}
+		consumed = true;
+	}
+out:
+	raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+	return consumed;
+}
+
+int gh_hwbp_direct_arm(pid_t tid, unsigned long pc)
+{
+	struct task_struct *task;
+	struct pid *pid;
+	unsigned long flags;
+	int cpu;
+	int slot;
+
+	if (tid <= 0 || (pc & 0x3))
+		return -EINVAL;
+	if (!gh_hwbp_direct_router_ready || core_num_brps < 2)
+		return -EOPNOTSUPP;
+
+	pid = find_get_pid(tid);
+	if (!pid)
+		return -ESRCH;
+	task = get_pid_task(pid, PIDTYPE_PID);
+	if (!task) {
+		put_pid(pid);
+		return -ESRCH;
+	}
+
+	slot = core_num_brps - 1;
+	raw_spin_lock_irqsave(&gh_hwbp_direct_lock, flags);
+	if (gh_hwbp_direct.active) {
+		raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+		put_task_struct(task);
+		put_pid(pid);
+		return -EBUSY;
+	}
+	/*
+	 * hw_breakpoint_control() uses this same lock while claiming a perf
+	 * execution slot.  The scan and state transition are therefore atomic
+	 * against a concurrent perf install on the final physical BRP.
+	 */
+	for_each_online_cpu(cpu) {
+		if (per_cpu(bp_on_reg, cpu)[slot]) {
+			raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+			put_task_struct(task);
+			put_pid(pid);
+			return -EBUSY;
+		}
+	}
+	gh_hwbp_direct.pid = pid;
+	gh_hwbp_direct.pc = pc;
+	gh_hwbp_direct.hits = 0;
+	gh_hwbp_direct.slot = slot;
+	gh_hwbp_direct.disarming = false;
+	gh_hwbp_direct.stepping = false;
+	gh_hwbp_direct.active = true;
+	raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+
+	/* Install immediately if the TID is currently running, else at switch-in. */
+	on_each_cpu(gh_hwbp_direct_sync_current, NULL, 1);
+	put_task_struct(task);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gh_hwbp_direct_arm);
+
+int gh_hwbp_direct_disarm(pid_t tid)
+{
+	struct pid *owned;
+	unsigned long flags;
+
+	if (tid <= 0)
+		return -EINVAL;
+
+	raw_spin_lock_irqsave(&gh_hwbp_direct_lock, flags);
+	/* The retained pid reference also prevents this TID from being recycled. */
+	if (!gh_hwbp_direct.active || pid_nr(gh_hwbp_direct.pid) != tid) {
+		raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+		return -ENOENT;
+	}
+	/*
+	 * A pending single-step must complete first or its HWSS would be handed to
+	 * the stock SIGTRAP path after teardown.  The fixture protocol therefore
+	 * disarms only after the target has exited (and callers otherwise retry).
+	 */
+	if (gh_hwbp_direct.stepping || gh_hwbp_direct.disarming) {
+		raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+		return -EBUSY;
+	}
+	gh_hwbp_direct.disarming = true;
+	raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+
+	/* Keep active/reserved until every CPU has cleared the direct BCR. */
+	on_each_cpu(gh_hwbp_direct_sync_current, NULL, 1);
+
+	raw_spin_lock_irqsave(&gh_hwbp_direct_lock, flags);
+	owned = gh_hwbp_direct.pid;
+	gh_hwbp_direct.pid = NULL;
+	gh_hwbp_direct.pc = 0;
+	gh_hwbp_direct.hits = 0;
+	gh_hwbp_direct.slot = -1;
+	gh_hwbp_direct.stepping = false;
+	gh_hwbp_direct.disarming = false;
+	gh_hwbp_direct.active = false;
+	raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+
+	/* State is inactive only after direct BCRs are gone, so perf may now use it. */
+	on_each_cpu(gh_hwbp_direct_sync_current, NULL, 1);
+	put_pid(owned);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gh_hwbp_direct_disarm);
+
+int gh_hwbp_direct_get_stats(struct gh_hwbp_direct_stats *stats)
+{
+	unsigned long flags;
+
+	if (!stats)
+		return -EINVAL;
+	raw_spin_lock_irqsave(&gh_hwbp_direct_lock, flags);
+	stats->tid = gh_hwbp_direct.pid ? pid_nr(gh_hwbp_direct.pid) : 0;
+	stats->pc = gh_hwbp_direct.pc;
+	stats->hits = gh_hwbp_direct.hits;
+	stats->armed = gh_hwbp_direct.active && !gh_hwbp_direct.disarming;
+	raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(gh_hwbp_direct_get_stats);
+
 int hw_breakpoint_slots(int type)
 {
 	/*
@@ -227,6 +476,8 @@ static int hw_breakpoint_control(struct perf_event *bp,
 	struct debug_info *debug_info = &current->thread.debug;
 	int i, max_slots, ctrl_reg, val_reg, reg_enable;
 	enum dbg_active_el dbg_el = debug_exception_level(info->ctrl.privilege);
+	unsigned long gh_flags = 0;
+	bool gh_execution_lock = false;
 	u32 ctrl;
 
 	if (info->ctrl.type == ARM_BREAKPOINT_EXECUTE) {
@@ -234,7 +485,11 @@ static int hw_breakpoint_control(struct perf_event *bp,
 		ctrl_reg = AARCH64_DBG_REG_BCR;
 		val_reg = AARCH64_DBG_REG_BVR;
 		slots = this_cpu_ptr(bp_on_reg);
-		max_slots = core_num_brps;
+		/* Serialize final-slot claiming with gh_hwbp_direct_arm(). */
+		raw_spin_lock_irqsave(&gh_hwbp_direct_lock, gh_flags);
+		gh_execution_lock = true;
+		/* A live GhostHook direct session owns the final physical BRP. */
+		max_slots = core_num_brps - (READ_ONCE(gh_hwbp_direct.active) ? 1 : 0);
 		reg_enable = !debug_info->bps_disabled;
 	} else {
 		/* Watchpoint */
@@ -246,6 +501,8 @@ static int hw_breakpoint_control(struct perf_event *bp,
 	}
 
 	i = hw_breakpoint_slot_setup(slots, max_slots, bp, ops);
+	if (gh_execution_lock)
+		raw_spin_unlock_irqrestore(&gh_hwbp_direct_lock, gh_flags);
 
 	if (WARN_ONCE(i < 0, "Can't find any breakpoint slot"))
 		return i;
@@ -933,6 +1190,9 @@ void hw_breakpoint_thread_switch(struct task_struct *next)
 		toggle_bp_registers(AARCH64_DBG_REG_WCR,
 				    DBG_ACTIVE_EL0,
 				    !next_debug_info->wps_disabled);
+
+	/* Program/clear the direct owner on this CPU for the incoming TID. */
+	gh_hwbp_direct_sync_task(next);
 }
 
 /*
@@ -970,6 +1230,9 @@ static int hw_breakpoint_reset(unsigned int cpu)
 		}
 	}
 
+	/* CPU PM/hotplug reset clears registers; restore a live direct session. */
+	gh_hwbp_direct_sync_task(current);
+
 	return 0;
 }
 
@@ -1013,6 +1276,16 @@ static int __init arch_hw_breakpoint_init(void)
 	/* Register cpu_suspend hw breakpoint restore hook */
 	cpu_suspend_set_dbg_restorer(hw_breakpoint_reset);
 
+	if (!ret) {
+		int gh_ret;
+
+		gh_ret = gh_debug_router_register_core(gh_hwbp_direct_debug_event, NULL);
+		if (gh_ret)
+			pr_err("failed to register GhostHook direct debug router: %d\n", gh_ret);
+		else
+			gh_hwbp_direct_router_ready = true;
+	}
+
 	return ret;
 }
 arch_initcall(arch_hw_breakpoint_init);
diff --git a/arch/arm64/mm/fault.c b/arch/arm64/mm/fault.c
index 85c46b8..2b5383a 100755
--- a/arch/arm64/mm/fault.c
+++ b/arch/arm64/mm/fault.c
@@ -927,6 +927,28 @@ struct gh_debug_router_binding {
 
 static DEFINE_RAW_SPINLOCK(gh_debug_router_lock);
 static struct gh_debug_router_binding gh_debug_router_binding;
+/* Core callbacks are built into the kernel and never point into KPM text. */
+static struct gh_debug_router_binding gh_debug_router_core_binding;
+
+int gh_debug_router_register_core(gh_debug_router_fn_t fn, void *context)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!fn)
+		return -EINVAL;
+
+	raw_spin_lock_irqsave(&gh_debug_router_lock, flags);
+	if (READ_ONCE(gh_debug_router_core_binding.fn))
+		ret = -EBUSY;
+	else {
+		WRITE_ONCE(gh_debug_router_core_binding.context, context);
+		WRITE_ONCE(gh_debug_router_core_binding.fn, fn);
+	}
+	raw_spin_unlock_irqrestore(&gh_debug_router_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gh_debug_router_register_core);
 
 int gh_debug_router_register(gh_debug_router_fn_t fn, void *context)
 {
@@ -976,10 +998,16 @@ static bool __nocfi gh_debug_router_dispatch(unsigned long addr_if_watchpoint,
 	bool consumed = false;
 
 	raw_spin_lock_irqsave(&gh_debug_router_lock, flags);
-	fn = READ_ONCE(gh_debug_router_binding.fn);
-	context = READ_ONCE(gh_debug_router_binding.context);
+	fn = READ_ONCE(gh_debug_router_core_binding.fn);
+	context = READ_ONCE(gh_debug_router_core_binding.context);
 	if (fn)
 		consumed = fn(addr_if_watchpoint, esr, regs, context);
+	if (!consumed) {
+		fn = READ_ONCE(gh_debug_router_binding.fn);
+		context = READ_ONCE(gh_debug_router_binding.context);
+		if (fn)
+			consumed = fn(addr_if_watchpoint, esr, regs, context);
+	}
 	raw_spin_unlock_irqrestore(&gh_debug_router_lock, flags);
 	return consumed;
 }
