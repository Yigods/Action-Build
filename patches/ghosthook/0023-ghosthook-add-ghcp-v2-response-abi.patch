+/*
+ * GHCP v2 keeps the 64-byte request header but adds a bounded kernel-owned
+ * response and immutable caller identity.  Only the core copies user memory.
+ */
+#define GH_CONTROL_ABI_V2 2U
+#define GH_CONTROL_V2_REQUEST_PAYLOAD_MAX 256U
+#define GH_CONTROL_V2_REQUEST_MAX \
+	(sizeof(struct gh_control_header_v1) + GH_CONTROL_V2_REQUEST_PAYLOAD_MAX)
+#define GH_CONTROL_V2_RESPONSE_MAX 4096U
+#define GH_CONTROL_V2_RESPONSE_FLAG 1U
+#define GH_CONTROL_SESSION_CLOSE 7U
+struct gh_control_response_v2 {
+	u32 magic;
+	u16 abi;
+	u16 command;
+	u32 flags;
+	u32 payload_len;
+	u64 session_id;
+	u64 nonce;
+	s32 status;
+	u32 reserved;
+	u64 server_sequence;
+};
+
+struct gh_control_caller_v2 {
+	u32 uid;
+	u32 gid;
+	pid_t pid;
+	pid_t tgid;
+};
+
+typedef long (*gh_control_handler_v2_t)(const void *request,
+	size_t request_len, void *response,
+	size_t response_cap, const struct gh_control_caller_v2 *caller,
+	void *context);
+int gh_control_register_v2(gh_control_handler_v2_t handler, void *context);
+int gh_control_unregister_v2(gh_control_handler_v2_t handler, void *context);
+
 /* r13 VMA-less region API. A region is one bounded, owner-mm allocation that
  * transitions RW -> RX exactly once; callers must quiesce user execution
  * before destroy. */
