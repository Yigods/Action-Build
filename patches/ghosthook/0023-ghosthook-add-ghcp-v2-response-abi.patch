+static int gh_control_validate_response_v2(const void *frame,
+					   size_t frame_len,
+					   const struct gh_control_header_v1 *request)
+{
+	struct gh_control_response_v2 response;
+	size_t expected;
+
+	if (!frame || frame_len < sizeof(response) ||
+	    frame_len > GH_CONTROL_V2_RESPONSE_MAX)
+		return -EMSGSIZE;
+	memcpy(&response, frame, sizeof(response));
+	if (response.magic != GH_CONTROL_MAGIC ||
+	    response.abi != GH_CONTROL_ABI_V2 ||
+	    response.flags != GH_CONTROL_V2_RESPONSE_FLAG || response.reserved)
+		return -EPROTO;
+	if (response.command != request->command || response.nonce != request->nonce)
+		return -EPROTO;
+	if (request->command == GH_CONTROL_HELLO) {
+		if (!response.session_id)
+			return -EPROTO;
+	} else if (response.session_id != request->session_id) {
+		return -EPROTO;
+	}
+	expected = sizeof(response) + (size_t)response.payload_len;
+	if (expected != frame_len || expected > GH_CONTROL_V2_RESPONSE_MAX)
+		return -EMSGSIZE;
+	return 0;
+}
