+SYSCALL_DEFINE4(ghosthook_control, const void __user *, request,
+		size_t, request_len, void __user *, response, size_t, response_cap)
+{
+	u8 local[GH_CONTROL_V2_REQUEST_MAX];
+	struct gh_control_header_v1 header;
+
+	if (!request || request_len < sizeof(header) || request_len > sizeof(local))
+		return -EMSGSIZE;
+	if (copy_from_user(local, request, request_len))
+		return -EFAULT;
+	memcpy(&header, local, sizeof(header));
+	if (header.abi == GH_CONTROL_ABI_V1)
+		return gh_control_dispatch_v1(local, request_len);
+	if (header.abi == GH_CONTROL_ABI_V2)
+		return gh_control_dispatch_v2(local, request_len, response, response_cap);
+	return -EPROTO;
+}
