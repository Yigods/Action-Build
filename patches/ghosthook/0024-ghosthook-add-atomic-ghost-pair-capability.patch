+	    length >> PAGE_SHIFT > GH_GHOST_MAX_PAGES)
+		return ERR_PTR(-EINVAL);
+	region = kzalloc(sizeof(*region), GFP_KERNEL);
+	if (!region)
+		return ERR_PTR(-ENOMEM);
+	region->nr_pages = length >> PAGE_SHIFT;
+	region->pages = kcalloc(region->nr_pages, sizeof(*region->pages),
+				GFP_KERNEL);
+	if (!region->pages) {
+		kfree(region);
+		return ERR_PTR(-ENOMEM);
+	}
+	region->mm = mm;
+	region->length = length;
+	/* Keep mm_struct storage alive even after its last users exits. */
+	mmgrab(mm);
+	for (i = 0; i < region->nr_pages; ++i) {
+		region->pages[i] = alloc_page(GFP_KERNEL | __GFP_ZERO);
+		if (!region->pages[i]) {
