+int gh_ghost_region_destroy_pair(struct mm_struct *mm, u64 code_handle,
+				 u64 data_handle)
+{
+	struct gh_ghost_region *code, *data;
+	int ret;
+
+	if (!mm || !code_handle || !data_handle || code_handle == data_handle)
+		return -EINVAL;
+	mmap_write_lock(mm);
+	mutex_lock(&gh_ghost_lock);
+	code = gh_ghost_find_handle_locked(mm, code_handle);
+	data = gh_ghost_find_handle_locked(mm, data_handle);
+	if (!code || !data || code->start + code->length != data->start ||
+	    (code->state != GH_GHOST_STATE_RW &&
+	     code->state != GH_GHOST_STATE_RX) ||
+	    data->state != GH_GHOST_STATE_RW) {
+		ret = -ENOENT;
+		goto out;
+	}
+	ret = gh_ghost_clear_locked(code);
+	if (ret) {
+		(void)gh_ghost_restore_locked(code);
+		goto out;
+	}
+	ret = gh_ghost_clear_locked(data);
+	if (ret) {
+		(void)gh_ghost_restore_locked(data);
+		(void)gh_ghost_restore_locked(code);
+		goto out;
+	}
+	list_del(&code->node);
+	list_del(&data->node);
+	mutex_unlock(&gh_ghost_lock);
+	mmap_write_unlock(mm);
+	gh_ghost_release_region(code);
+	gh_ghost_release_region(data);
+	return 0;
+out:
+	mutex_unlock(&gh_ghost_lock);
+	mmap_write_unlock(mm);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gh_ghost_region_destroy_pair);
