+int gh_ghost_region_create_pair_auto(struct mm_struct *mm,
+				     unsigned long code_length,
+				     unsigned long data_length,
+				     unsigned long *base_out,
+				     u64 *code_handle_out,
+				     u64 *data_handle_out)
+{
+	struct gh_ghost_region *code, *data;
+	struct gh_ghost_pte_txn txn;
+	unsigned long base, total;
+	int ret;
+
+	if (!mm || mm != current->mm || !base_out || !code_handle_out ||
+	    !data_handle_out || !code_length || !data_length ||
+	    (code_length & ~PAGE_MASK) || (data_length & ~PAGE_MASK) ||
+	    code_length >> PAGE_SHIFT > GH_GHOST_MAX_PAGES ||
+	    data_length >> PAGE_SHIFT > GH_GHOST_MAX_PAGES ||
+	    code_length > TASK_SIZE - data_length)
+		return -EINVAL;
+	total = code_length + data_length;
+	code = gh_ghost_alloc_region(mm, code_length);
+	if (IS_ERR(code))
+		return PTR_ERR(code);
+	data = gh_ghost_alloc_region(mm, data_length);
+	if (IS_ERR(data)) {
+		ret = PTR_ERR(data);
+		goto fail_code;
+	}
+
+	mmap_write_lock(mm);
+	mutex_lock(&gh_ghost_lock);
+	/* A pair is one indivisible owner allocation.  Do not fill a single
+	 * remaining slot or combine it with a legacy region. */
+	if (gh_ghost_mm_region_count_locked(mm)) {
+		ret = -EBUSY;
+		goto fail_unlock;
+	}
+	base = get_unmapped_area(NULL, 0, total, 0, 0);
+	if (IS_ERR_VALUE(base)) {
+		ret = (long)base;
+		goto fail_unlock;
+	}
+	if (!gh_ghost_range_valid(base, total) ||
+	    find_vma_intersection(mm, base, base + total)) {
+		ret = -EBUSY;
+		goto fail_unlock;
+	}
+	code->start = base;
+	code->handle = atomic64_inc_return(&gh_ghost_next_handle);
+	code->state = GH_GHOST_STATE_RW;
+	data->start = base + code_length;
+	data->handle = atomic64_inc_return(&gh_ghost_next_handle);
+	data->state = GH_GHOST_STATE_RW;
+
+	/* Probing both regions first allocates every intermediate page table.
+	 * Installation then cannot partially succeed because of page-table
+	 * allocation failure, and no VMA operation can race the mmap lock. */
+	txn.op = GH_GHOST_PTE_PROBE;
+	txn.region = code;
+	ret = apply_to_page_range(mm, code->start, code->length,
+				  gh_ghost_pte_callback, &txn);
+	if (ret)
+		goto fail_unlock;
+	txn.region = data;
+	ret = apply_to_page_range(mm, data->start, data->length,
+				  gh_ghost_pte_callback, &txn);
+	if (ret)
+		goto fail_unlock;
+
+	txn.prot = vm_get_page_prot(VM_READ | VM_WRITE | VM_MAYREAD |
+				    VM_MAYWRITE | VM_SHARED);
+	txn.op = GH_GHOST_PTE_INSTALL;
+	txn.region = code;
+	ret = apply_to_page_range(mm, code->start, code->length,
+				  gh_ghost_pte_callback, &txn);
+	if (ret)
+		goto fail_install;
+	txn.region = data;
+	ret = apply_to_page_range(mm, data->start, data->length,
+				  gh_ghost_pte_callback, &txn);
+	if (ret)
+		goto fail_install;
+	flush_tlb_mm(mm);
+	list_add_tail(&code->node, &gh_ghost_regions);
+	list_add_tail(&data->node, &gh_ghost_regions);
+	*base_out = base;
+	*code_handle_out = code->handle;
+	*data_handle_out = data->handle;
+	mutex_unlock(&gh_ghost_lock);
+	mmap_write_unlock(mm);
+	return 0;
+
+fail_install:
+	(void)gh_ghost_rollback_locked(data);
+	(void)gh_ghost_rollback_locked(code);
+fail_unlock:
+	mutex_unlock(&gh_ghost_lock);
+	mmap_write_unlock(mm);
+	gh_ghost_release_region(data);
+fail_code:
+	gh_ghost_release_region(code);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(gh_ghost_region_create_pair_auto);
