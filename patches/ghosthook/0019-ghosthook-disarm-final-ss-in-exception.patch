From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: no_trace <noreply@example.invalid>
Date: Sat, 1 Aug 2026 17:10:00 +0800
Subject: [PATCH] ghosthook: disarm final owned HWSS in its exception context

On the r17 target, a bounded 64-hit session records all hits but its target
never reaches the fixture continuation.  The final event currently drops
ownership and defers TIF_SINGLESTEP cleanup to resume task_work, leaving a
window for an unowned EL0 single-step trap.

The final debug exception already runs in the owned current task. Clear the
pending SPSR.SS state and TIF_SINGLESTEP there, just as the direct HWBP path
cleans up its locally owned single-step state. Retain deferred task_work only
for explicit external stop paths.

---
 arch/arm64/kernel/gh_ss_trace.c | 19 ++++++++-----------
 1 file changed, 8 insertions(+), 11 deletions(-)

diff --git a/arch/arm64/kernel/gh_ss_trace.c b/arch/arm64/kernel/gh_ss_trace.c
index ffffffff..eeeeeeee 100644
--- a/arch/arm64/kernel/gh_ss_trace.c
+++ b/arch/arm64/kernel/gh_ss_trace.c
@@ -129,7 +129,6 @@ static bool gh_ss_trace_debug_event(unsigned long addr_if_watchpoint,
 {
 	unsigned long flags;
 	bool consumed = false;
-	bool queue_disarm = false;
 
 	(void)addr_if_watchpoint;
 	(void)context;
@@ -142,12 +141,13 @@ static bool gh_ss_trace_debug_event(unsigned long addr_if_watchpoint,
 	gh_ss_trace_record_locked(regs);
 	gh_ss_trace.hits++;
 	if (gh_ss_trace.hits >= gh_ss_trace.limit) {
-		/* Defer SS teardown to this task's EL0-return task_work. */
-		init_task_work(&gh_ss_trace.disarm_work, gh_ss_trace_disarm_work);
-		gh_ss_trace.disarm_work_pending = true;
+		/* This exception is already executing in the owned target task.
+		 * Clear both the pending SPSR.SS bit and TIF_SINGLESTEP before
+		 * returning, rather than leaving one unowned step for task_work. */
+		user_fastforward_single_step(current);
+		user_disable_single_step(current);
 		gh_ss_trace.ss_owned = false;
 		gh_ss_trace.active = false;
-		queue_disarm = true;
 	} else {
 		/* We consumed HWSS before stock single_step_handler's rewind. */
 		user_rewind_single_step(current);
@@ -155,12 +155,6 @@ static bool gh_ss_trace_debug_event(unsigned long addr_if_watchpoint,
 	consumed = true;
 out:
 	raw_spin_unlock_irqrestore(&gh_ss_trace_lock, flags);
-	if (queue_disarm &&
-	    task_work_add(current, &gh_ss_trace.disarm_work, TWA_RESUME)) {
-		raw_spin_lock_irqsave(&gh_ss_trace_lock, flags);
-		gh_ss_trace.disarm_work_pending = false;
-		raw_spin_unlock_irqrestore(&gh_ss_trace_lock, flags);
-	}
 	return consumed;
 }
 
